{
  "$schema": "acc-workshop/ui-flow/1.0",
  "meta": {
    "app": "ACC Empathy Workshop",
    "version": "1.0",
    "generatedFrom": "src/App.jsx, src/main.jsx, src/preview/Preview.jsx",
    "description": "Structural UI flow seed for human-readable diagrams. Two URL routes; role and board navigation use in-app state plus shared storage sync.",
    "routingModel": {
      "urlRouter": "react-router-dom (BrowserRouter)",
      "inAppRouter": "React useState view in ACCWorkshop",
      "crossDeviceSync": "window.storage (Supabase or localStorage + BroadcastChannel), polled every 3s"
    }
  },
  "entryPoints": [
    {
      "id": "ep-root",
      "path": "/",
      "method": "GET",
      "role": "both",
      "resolvesTo": "landing",
      "description": "Default workshop app bootstrap via index.html → main.jsx → App.jsx"
    },
    {
      "id": "ep-participant-deeplink",
      "path": "/",
      "query": { "role": "participant" },
      "role": "participant",
      "resolvesTo": "participant-shell",
      "description": "QR code and manual phone join; skips landing"
    },
    {
      "id": "ep-facilitator-deeplink",
      "path": "/",
      "query": { "role": "facilitator" },
      "role": "facilitator",
      "resolvesTo": "facilitator-shell",
      "description": "Direct facilitator entry; skips landing"
    },
    {
      "id": "ep-room",
      "path": "/",
      "query": { "room": "<name>" },
      "role": "both",
      "resolvesTo": null,
      "description": "Storage namespace isolation; composable with role query params"
    },
    {
      "id": "ep-preview",
      "path": "/preview",
      "role": "dev",
      "resolvesTo": "preview-canvas",
      "description": "Hi-fi design canvas with side-by-side participant phone and facilitator projector frames"
    }
  ],
  "boards": [
    { "id": "empathy", "en": "Empathy Maps", "zh": "同理心地圖", "storageKey": "acc-active-board", "stickyKey": "acc-stickies-empathy" },
    { "id": "parking", "en": "Parking Lot", "zh": "暫存區", "storageKey": "acc-active-board", "stickyKey": "acc-stickies-parking-lot" },
    { "id": "reflections", "en": "Reflections", "zh": "反思", "storageKey": "acc-active-board", "stickyKey": "acc-stickies-reflections" },
    { "id": "practices", "en": "Practice Proposals", "zh": "實踐提案", "storageKey": "acc-active-board", "stickyKey": "acc-stickies-practices" },
    { "id": "commitments", "en": "Commitments", "zh": "個人承諾", "storageKey": "acc-active-board", "stickyKey": "acc-stickies-commitments" }
  ],
  "nodes": [
    {
      "id": "bootstrap",
      "type": "system",
      "role": "both",
      "label": "App bootstrap",
      "component": "main.jsx",
      "layer": "infrastructure"
    },
    {
      "id": "landing",
      "type": "screen",
      "role": "both",
      "label": "Landing · Role chooser",
      "labelZh": "選擇角色",
      "component": "Landing",
      "layer": "top-level",
      "description": "Full-screen hero with two role cards"
    },
    {
      "id": "participant-shell",
      "type": "shell",
      "role": "participant",
      "label": "Participant app shell",
      "component": "ParticipantApp",
      "layer": "top-level",
      "layout": ["sticky-header", "board-flow-main", "fixed-parking-fab"]
    },
    {
      "id": "facilitator-shell",
      "type": "shell",
      "role": "facilitator",
      "label": "Facilitator app shell",
      "component": "FacilitatorApp",
      "layer": "top-level",
      "layout": ["sticky-header-with-board-tabs", "scrollable-board-main"]
    },
    {
      "id": "preview-canvas",
      "type": "screen",
      "role": "dev",
      "label": "Preview canvas",
      "component": "Preview",
      "layer": "top-level",
      "description": "Dual framed live App instances auto-entering each role"
    },
    {
      "id": "centered-loader",
      "type": "gate",
      "role": "both",
      "label": "Connecting / Loading",
      "component": "CenteredLoader",
      "layer": "gate",
      "description": "Shown during initial storage poll or facilitator lock check"
    },
    {
      "id": "fac-lock-pending",
      "type": "gate",
      "role": "facilitator",
      "label": "Facilitator lock · pending",
      "component": "FacilitatorLockModal",
      "layer": "gate",
      "mode": "pending"
    },
    {
      "id": "fac-lock-displaced",
      "type": "overlay",
      "role": "facilitator",
      "label": "Facilitator lock · displaced",
      "component": "FacilitatorLockModal",
      "layer": "gate",
      "mode": "displaced"
    },
    {
      "id": "fac-board-empathy",
      "type": "board",
      "role": "facilitator",
      "label": "Empathy Maps board",
      "component": "EmpathyBoard",
      "boardId": "empathy",
      "layer": "facilitator-board"
    },
    {
      "id": "fac-board-empathy-grid",
      "type": "subview",
      "role": "facilitator",
      "label": "Empathy · Gallery (8 personas)",
      "parent": "fac-board-empathy",
      "layer": "facilitator-board"
    },
    {
      "id": "fac-board-empathy-focus",
      "type": "subview",
      "role": "facilitator",
      "label": "Empathy · Focus (1 persona)",
      "parent": "fac-board-empathy",
      "layer": "facilitator-board"
    },
    {
      "id": "fac-board-parking",
      "type": "board",
      "role": "facilitator",
      "label": "Parking Lot board",
      "component": "SimpleBoard",
      "boardId": "parking",
      "layer": "facilitator-board"
    },
    {
      "id": "fac-board-reflections",
      "type": "board",
      "role": "facilitator",
      "label": "Reflections board",
      "component": "SimpleBoard",
      "boardId": "reflections",
      "layer": "facilitator-board"
    },
    {
