  "syncLinks": [
    {
      "id": "sync-active-board",
      "driver": "facilitator",
      "follower": "participant",
      "storageKey": "acc-active-board",
      "direction": "facilitator-to-participant",
      "mechanism": "Facilitator setActiveBoard writes; participant polls every 3s",
      "effect": "Participant main content switches between board flows; participant cannot change board"
    },
    {
      "id": "sync-stickies",
      "driver": "participant",
      "follower": "facilitator",
      "storageKeys": [
        "acc-stickies-empathy",
        "acc-stickies-parking-lot",
        "acc-stickies-reflections",
        "acc-stickies-practices",
        "acc-stickies-commitments"
      ],
      "direction": "participant-to-facilitator",
      "mechanism": "Participant submit writes; facilitator polls every 3s",
      "effect": "Facilitator board views update with new stickies"
    },
    {
      "id": "sync-personas",
      "driver": "facilitator",
      "follower": "participant",
      "storageKey": "acc-personas",
      "direction": "facilitator-to-participant",
      "mechanism": "Settings persona edits; both roles poll",
      "effect": "Participant persona picker reflects facilitator edits"
    },
    {
      "id": "sync-facilitator-lock",
      "driver": "facilitator",
      "follower": "facilitator",
      "storageKey": "acc-facilitator-lock",
      "direction": "bidirectional",
      "mechanism": "Heartbeat every 5s; stale after 15s",
      "effect": "Only one active facilitator session per room"
    },
    {
      "id": "sync-commitments-from-practices",
      "driver": "participant",
      "follower": "participant",
      "storageKey": "acc-stickies-practices",
      "direction": "indirect",
      "mechanism": "Commitments SimpleFlow polls practices every 4s for tap-to-fill suggestions",
      "effect": "Practice proposals surface as commitment suggestions on participant phone only"
    }
  ],
